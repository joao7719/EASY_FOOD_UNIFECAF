# PostgreSQL local da EasyFood
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/easyfood?schema=public"

# Segredo longo e aleatório; nunca commitar o arquivo .env real
JWT_SECRET="troque-por-uma-chave-longa-e-aleatoria"

# Integração de e-mail via API Resend (opcional em desenvolvimento)
EMAIL_PROVIDER="resend"
EMAIL_API_URL="https://api.resend.com/emails"
EMAIL_API_KEY=""
EMAIL_FROM="EasyFood <onboarding@resend.dev>"
EMAIL_FROM_NAME="EasyFood"
EMAIL_NOTIFICATION_TO=""
